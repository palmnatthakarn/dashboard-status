      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define=BASE_URL=https://api.dev.dedepos.com"
      ]
    },
    {
      "name": "🌐 Web - Production",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "-d",
        "chrome",
        "--dart-define=BASE_URL=https://api.dedepos.com",
        "--release"
      ]
    }
